<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- HTTP tanpa TLS diizinkan HANYA pada build debug, supaya API lokal
         (http://10.0.2.2:8080) bisa dipanggil dari emulator.

         Pada build release, `usesCleartextTraffic="false"` di manifest utama
         tetap berlaku: tablet di sekolah harus memanggil API lewat HTTPS,
         karena payload absensi membawa data biometrik. -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
